# Public Supabase configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://northernstingers.store

# Server-only secrets: never use NEXT_PUBLIC_ for these values
SUPABASE_SERVICE_ROLE_KEY=
SWISH_NUMBER=
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=

# E-postbekräftelser via Resend (se README)
RESEND_API_KEY=
EMAIL_FROM=Northern Stingers <order@northernstingers.store>
# Valfritt: dit kundsvar går om kunden svarar på mejlet
EMAIL_REPLY_TO=

# Publika säljaruppgifter – fyll i korrekta uppgifter före lansering
BUSINESS_LEGAL_NAME=
BUSINESS_ORG_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_RETURN_ADDRESS=
BUSINESS_VAT_NUMBER=
BUSINESS_EMAIL=info@northernstingers.store
PUBLIC_DELIVERY_ESTIMATE=

# Nyhetsbrevet använder double opt-in via Resend. Verifiera domänen för EMAIL_FROM i Resend.
